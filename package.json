{
  "private": true,
  "name": "my-nextron-app",
  "description": "My application description",
  "version": "1.0.0",
  "author": "Yoshihide Shiono <shiono.yoshihide@gmail.com>",
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "dev": "nextron",
    "build": "nextron build",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scripts/test-runner.mjs all",
    "typecheck": "node tests/typecheck.cjs",
    "test:legacy": "node scripts/test-runner.mjs legacy",
    "test:unit": "node scripts/test-runner.mjs unit",
    "test:dom": "node scripts/test-runner.mjs dom",
    "test:services": "node scripts/test-runner.mjs services",
    "test:e2e": "node scripts/test-runner.mjs e2e",
    "test:runtime": "node scripts/runtime-e2e.mjs",
    "test:watch": "node scripts/test-runner.mjs watch",
    "try-deploy": "tsx scripts/test-and-deploy.ts",
    "build:mac": "nextron build --mac",
    "test:packaged": "node scripts/qualify-macos.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "screenshots": "node scripts/readme-screenshots.mjs",
    "build:local": "nextron build --no-pack && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir",
    "start:local": "open dist/mac-arm64/amber.app",
    "build:local:open": "npm run build:local && npm run start:local"
  },
  "dependencies": {
    "electron-serve": "^3.0.0",
    "electron-store": "^11.0.2",
    "mock-stdin": "^1.0.0",
    "react-grid-layout": "^2.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.15",
    "@types/react": "^19.2.14",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "next": "^16.2.1",
    "nextron": "^10.0.0",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "0.35.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
